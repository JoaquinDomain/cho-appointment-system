# Copy to .env.local and fill in — never commit .env.local
#
# PRODUCTION (Bacolod MIT server — patient booking site):
#   File lives at the app root on the server, chmod 600.
#
# BUILD-TIME vs RUNTIME variables
#   BUILD-TIME (NEXT_PUBLIC_*): inlined into the JavaScript bundle when
#     `next build` runs. Changing them later has NO effect until you rebuild.
#     Set them BEFORE `npm run build`.
#   RUNTIME (MYSQL_*, TURNSTILE_SECRET_KEY, RL_*): read on the server per
#     request, changeable without a rebuild (restart to clear in-memory state).

# MySQL 8.0 (server-only; the browser never sees these).
# Database name on the MITCS server: bcho_lab_appointment
# Schema: ./mysql/schema.sql
# Production runs on the same server as MySQL -> MYSQL_HOST=127.0.0.1
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=bcho_lab_appointment
MYSQL_USER=
MYSQL_PASSWORD=

# Optional MySQL settings
# MYSQL_CONNECTION_LIMIT=10
# TLS (only if the MITCS MySQL config requires it)
# MYSQL_SSL=true
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# MYSQL_SSL_CERT=/absolute/path/to/client-cert.pem
# MYSQL_SSL_KEY=/absolute/path/to/client-key.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Single site: leave NEXT_PUBLIC_APP_MODE UNSET for production — booking at /,
# staff login at /admin (footer link). Setting 'admin' only makes / redirect to
# /admin (convenience for local development of the admin dashboard; `next dev`
# only). `next build` FAILS with a clear error if this is set to 'admin', so a
# production site can never ship with the patient homepage redirecting away.
# NEXT_PUBLIC_APP_MODE=admin
# Patient booking URL advertised by the admin QR poster (build-time).
# Must be the official https:// cho-services-appointment.bacolodcity.gov.ph
# domain. In production the poster rejects non-https URLs and any *.vercel.app
# host (the retired hosting) and shows an error instead of printing a QR code.
NEXT_PUBLIC_PATIENT_SITE_URL=https://cho-services-appointment.bacolodcity.gov.ph/

# Cloudflare Turnstile (anti-spam for public booking)
# Get from Cloudflare Dashboard > Turnstile. Secret stays server-only.
# Booking fails closed in production if the secret is missing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Rate limiting (optional — defaults shown; leave unset to use the defaults).
# Counters are per server instance and reset on restart. RL_*_LIMIT is the max
# number of requests allowed per window; RL_*_WINDOW_MS is the window in
# milliseconds. Invalid values are ignored and the default is used.
# Admin login attempts per IP: 10 per 10 minutes
# RL_LOGIN_IP_LIMIT=10
# RL_LOGIN_IP_WINDOW_MS=600000
# Failed admin logins per account email: 5 per 15 minutes
# RL_LOGIN_FAIL_LIMIT=5
# RL_LOGIN_FAIL_WINDOW_MS=900000
# Public bookings per IP: 10 per 10 minutes
# RL_BOOK_IP_LIMIT=10
# RL_BOOK_IP_WINDOW_MS=600000
# Bookings without Turnstile verification per IP: 3 per 60 minutes
# RL_BOOK_UNVERIFIED_IP_LIMIT=3
# RL_BOOK_UNVERIFIED_IP_WINDOW_MS=3600000
