# Copy to .env.local and fill in — never commit .env.local

# MySQL 8.0 (server-only; the browser never sees these).
# Database name on the MITCS server: bcho_lab_appointment
# Schema: ./mysql/schema.sql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=bcho_lab_appointment
MYSQL_USER=
MYSQL_PASSWORD=

# Optional MySQL settings
# MYSQL_CONNECTION_LIMIT=10
# TLS (only if the MITCS MySQL config requires it)
# MYSQL_SSL=true
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# MYSQL_SSL_CERT=/absolute/path/to/client-cert.pem
# MYSQL_SSL_KEY=/absolute/path/to/client-key.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Split deployments: 'admin' on the staff site, unset/anything-else on patient site
# NEXT_PUBLIC_APP_MODE=admin
# Patient booking URL advertised by the admin QR poster
# NEXT_PUBLIC_PATIENT_SITE_URL=https://cho-appointment-system.vercel.app/

# Cloudflare Turnstile (anti-spam for public booking)
# Get from Cloudflare Dashboard > Turnstile. Secret stays server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
