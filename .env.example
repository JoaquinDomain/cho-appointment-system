# Copy to .env.local and fill in — never commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only (Vercel env, never NEXT_PUBLIC_): required for /api write+admin reads
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated admin emails allowed to use /api admin endpoints + dashboard data
# Example: ADMIN_EMAILS=admin@cho.gov.ph,lab@cho.gov.ph
ADMIN_EMAILS=

# Split deployments: 'admin' on the staff site, unset/anything-else on patient site
# NEXT_PUBLIC_APP_MODE=admin
# Patient booking URL advertised by the admin QR poster
# NEXT_PUBLIC_PATIENT_SITE_URL=https://your-patient-site.vercel.app
